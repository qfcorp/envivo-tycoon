; Ejemplo de la configuracion del servidor de EN VIVO Tycoon. Este archivo NO lleva datos reales.
; La configuracion de verdad vive FUERA del repositorio (que es publico): /etc/envivo/config.env
; La crea server/deploy/instalar.sh (permisos 640, dueno root, grupo www-data). Para editarla:
;   sudo nano /etc/envivo/config.env      y despues:   sudo systemctl reload php8.3-fpm

; Base de datos SQLite (fuera de la carpeta publica)
ENVIVO_DB=/var/lib/envivo/envivo.sqlite
; Direccion del juego (sin / al final)
ENVIVO_URL=https://juego.tukanec.com
ENVIVO_ZONA=America/Guayaquil

; Panel /admin.php: usuario y el HASH bcrypt de la clave (nunca la clave en texto). Para generar un hash:
;   php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_BCRYPT), "\n";'     (escribe la clave y Enter)
ENVIVO_ADMIN_USUARIO=
ENVIVO_ADMIN_CLAVE_HASH=

; Pago con tarjeta (Pago Plux). Queda en PRUEBAS (sandbox) hasta que Plux certifique; despues: PLUX_AMBIENTE=produccion
PLUX_AMBIENTE=sandbox
PLUX_ID_ESTABLECIMIENTO=
PLUX_ID_CLIENTE=
PLUX_CLAVE_SECRETA=
; La llave publica RSA de Plux en UNA linea (sin -----BEGIN/END-----)
PLUX_LLAVE_PUBLICA=
; Usuario y clave del aviso de pago (webhook) de Plux: https://juego.tukanec.com/api/plux/webhook
; (Opcional: el juego funciona sin el aviso; el pago aprobado se entrega al momento.)
PLUX_WEBHOOK_USUARIO=
PLUX_WEBHOOK_CLAVE=

; Soporte: lo muestra el juego en "Ayuda y soporte" (GET /api/soporte/contacto). Solo correo, sin WhatsApp.
SOPORTE_CORREO=
SOPORTE_HORARIO=

; Google Play (app de Android): ver server/GOOGLE_PLAY.md
; Nombre del paquete de la app (ej. com.tukanec.envivo) y ruta del .json de la cuenta de servicio (FUERA del repositorio)
GOOGLE_PACKAGE_NAME=com.tukanec.envivo
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/envivo/google-play.json

; Centro de Control /control/: segundo factor (php server/bin/control_totp.php), IPs permitidas y tope diario de créditos a mano
ENVIVO_ADMIN_TOTP=
ENVIVO_CONTROL_IPS=
ENVIVO_CONTROL_TOPE_CREDITOS=

; Bot de Discord (docs/DISCORD_BOT.md). Developer Portal > tu aplicación. Los TOKEN y WEBHOOK son SECRETOS.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLES_JSON=
DISCORD_WEBHOOK_ANUNCIOS=
DISCORD_WEBHOOK_EVENTOS=
DISCORD_WEBHOOK_ESTADO=
DISCORD_INVITACION=

; Mega Festival (server/INTEGRAR_FESTIVAL.md): fecha del primer festival (ISO). Vacío = 2026-10-01T12:00:00-05:00
FESTIVAL_INICIO=
; Liga Semanal (server/INTEGRAR_LIGA.md): firma | repeticion. LIGA_SECRETO vacío = se genera solo.
LIGA_VALIDACION=firma
LIGA_SECRETO=
; Validador de partidas (server/validador/README.md), lo usan Liga y Festival
VALIDADOR_URL=
VALIDADOR_CLAVE=
NODE_BIN=

; SOLO PRUEBAS: direcciones de un Plux y un Google falsos (dejar vacio o borrar en el servidor)
; PLUX_API_BASE=
; GOOGLE_API_BASE=
; GOOGLE_TOKEN_URL=
