; Ejemplo de la configuracion del servidor de EN VIVO Tycoon. Este archivo NO lleva datos reales.
; La configuracion de verdad vive FUERA del repositorio (que es publico): /etc/envivo/config.env
; La crea server/deploy/instalar.sh (permisos 640, dueno root, grupo www-data). Para editarla:
;   sudo nano /etc/envivo/config.env      y despues:   sudo systemctl reload php8.3-fpm

; Base de datos SQLite (fuera de la carpeta publica)
ENVIVO_DB=/var/lib/envivo/envivo.sqlite
; Direccion del juego (sin / al final)
ENVIVO_URL=https://juego.tukanec.com
ENVIVO_ZONA=America/Guayaquil

; Panel /admin.php: usuario y el HASH bcrypt de la clave (nunca la clave en texto). Para generar un hash:
;   php -r 'echo password_hash(trim(fgets(STDIN)), PASSWORD_BCRYPT), "\n";'     (escribe la clave y Enter)
ENVIVO_ADMIN_USUARIO=
ENVIVO_ADMIN_CLAVE_HASH=

; Pago con tarjeta (Pago Plux). En PRODUCCION (misma integracion de TuPass, ya certificada). Para pruebas: sandbox
PLUX_AMBIENTE=produccion
PLUX_ID_ESTABLECIMIENTO=
PLUX_ID_CLIENTE=
PLUX_CLAVE_SECRETA=
; La llave publica RSA de Plux en UNA linea (sin -----BEGIN/END-----)
PLUX_LLAVE_PUBLICA=
; Usuario y clave del aviso de pago (webhook) de Plux: https://juego.tukanec.com/api/plux/webhook
; (Opcional: el juego funciona sin el aviso; el pago aprobado se entrega al momento.)
PLUX_WEBHOOK_USUARIO=
PLUX_WEBHOOK_CLAVE=

; Soporte: lo muestra el juego en "Ayuda y soporte" (GET /api/soporte/contacto). Solo correo, sin WhatsApp.
; soporte@tukanec.com se crea gratis con Cloudflare Email Routing (reenvía a tu Gmail): ver docs/CORREO.md
SOPORTE_CORREO=soporte@tukanec.com
SOPORTE_HORARIO=

; Correo que manda el juego (recuperar la contraseña): SMTP de un proveedor de correo transaccional (Brevo gratis:
; 300 correos al día). Paso a paso en docs/CORREO.md. SMTP_SEGURIDAD: tls (puerto 587) o ssl (puerto 465).
; SMTP_CLAVE es SECRETA. Sin SMTP_HOST los correos NO salen: se escriben en CORREO_REGISTRO (vacío = correos.log
; junto a la base, /var/lib/envivo/correos.log). Para probar:  sudo -u www-data php /var/www/envivo/server/bin/correo_prueba.php tu@correo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURIDAD=tls
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DE=no-responder@tukanec.com
SMTP_NOMBRE=EN VIVO Tycoon
CORREO_REGISTRO=

; Google Play (app de Android): ver server/GOOGLE_PLAY.md
; Nombre del paquete de la app (ej. com.tukanec.envivo) y ruta del .json de la cuenta de servicio (FUERA del repositorio)
GOOGLE_PACKAGE_NAME=com.tukanec.envivo
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/envivo/google-play.json

; Centro de Control /control/: segundo factor (php server/bin/control_totp.php), IPs permitidas y tope diario de créditos a mano
ENVIVO_ADMIN_TOTP=
ENVIVO_CONTROL_IPS=
ENVIVO_CONTROL_TOPE_CREDITOS=

; Bot de Discord (docs/DISCORD_BOT.md). Developer Portal > tu aplicación. Los TOKEN y WEBHOOK son SECRETOS.
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLES_JSON=
DISCORD_WEBHOOK_ANUNCIOS=
DISCORD_WEBHOOK_EVENTOS=
DISCORD_WEBHOOK_ESTADO=
DISCORD_INVITACION=

; Mega Festival (server/INTEGRAR_FESTIVAL.md): fecha del primer festival (ISO). Vacío = 2026-10-01T12:00:00-05:00
FESTIVAL_INICIO=
; Liga Semanal (server/INTEGRAR_LIGA.md): firma | repeticion. LIGA_SECRETO vacío = se genera solo.
LIGA_VALIDACION=firma
LIGA_SECRETO=
; Validador de partidas (server/validador/README.md), lo usan Liga, Festival, Duelos y el Desafío del Día.
; NODE_BIN: solo si node no está en /usr/bin/node (server/eventos/motor.js corre con él al retar y al empezar el desafío)
VALIDADOR_URL=
VALIDADOR_CLAVE=
NODE_BIN=

; Universos (COPAS.md §1, server/INTEGRAR_UNIVERSOS.md): servidores con los que nace cada universo (1 a 12; el primero es
; el Universo Andino: Quito, Guayaquil, Cuenca). Vacío = 3. Opcionales (vacío = por defecto): ciudades para nombrar los
; servidores ("Servidor <id> · <ciudad n.º id>", separadas por coma), nombres de los universos que se abren solos y
; capacidad de los servidores nuevos (vacío = la del servidor más nuevo, 1000).
UNIVERSO_SERVIDORES_INICIALES=3
UNIVERSO_CIUDADES=
UNIVERSO_NOMBRES=
SERVIDOR_CAPACIDAD=
; Copa de Servidores (server/INTEGRAR_COPAS.md): COPA_SECRETO vacío = se genera solo; COPA_MOTOR_SEG = tiempo máximo del
; motor de batalla por cruce (vacío = 20).
COPA_SECRETO=
COPA_MOTOR_SEG=

; Facturación electrónica SRI con el ERP del dueño (docs/FACTURACION_SRI.md, server/INTEGRAR_FACTURACION.md).
; FACTURACION_CLAVE: secreto compartido con el ERP para la firma HMAC (32 caracteres o más; el MISMO en el ERP). SECRETO.
;   Para crear uno:  openssl rand -hex 32
; FACTURACION_IPS: opcional, IPs o redes (CIDR) desde donde el ERP llama a /api/facturacion/* (vacío = cualquiera con firma)
; FACTURACION_WEBHOOK_URL: opcional, https://... del ERP para avisarle cada comprobante nuevo (firmado igual)
; FACTURACION_ALERTA_CMD: opcional, programa que recibe la alerta de atrasos como texto (ej. /usr/local/bin/alerta-telegram.sh)
; FACTURACION_TOPE_CF: tope de una factura a consumidor final (vacío = 50, regla del SRI)
; FACTURACION_GOOGLE: 1 = también se facturan las compras de Google Play (a consumidor final); 0 = no (consultar al contador)
; FACTURACION_ACTIVA: 0 = no se crean comprobantes nuevos (vacío = 1)
FACTURACION_CLAVE=
FACTURACION_IPS=
FACTURACION_WEBHOOK_URL=
FACTURACION_ALERTA_CMD=
FACTURACION_TOPE_CF=
FACTURACION_GOOGLE=1
FACTURACION_ACTIVA=

; SOLO PRUEBAS: direcciones de un Plux y un Google falsos (dejar vacio o borrar en el servidor)
; PLUX_API_BASE=
; GOOGLE_API_BASE=
; GOOGLE_TOKEN_URL=

; Notificaciones push (server/INTEGRAR_PUSH.md): sudo php server/bin/push_claves.php --escribir. La PRIVADA es secreta.
PUSH_VAPID_PUBLICA=
PUSH_VAPID_PRIVADA=
PUSH_VAPID_SUJETO=mailto:soporte@tukanec.com
; Máximo de avisos por jugador al día (1–5, por defecto 3)
PUSH_MAX_DIA=3
