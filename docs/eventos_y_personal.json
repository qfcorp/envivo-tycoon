{
  "roles": [
    {
      "key": "director",
      "nombre": "Realizador / director",
      "que_hace": "Elige en vivo qué cámara sale al aire, pide planos y marca el ritmo.",
      "si_falta": "Planos que llegan tarde, se pierden goles y momentos clave; cada camarógrafo hace lo que cree.",
      "rol_actual_juego": "dir"
    },
    {
      "key": "productor",
      "nombre": "Productor / coordinador",
      "que_hace": "Habla con el cliente, arma la escaleta (guion por minutos), contrata y resuelve permisos.",
      "si_falta": "Retrasos, el cliente cambia todo a última hora y nadie avisa; se pierde el inicio o el discurso.",
      "rol_actual_juego": null
    },
    {
      "key": "camarografo",
      "nombre": "Camarógrafo",
      "que_hace": "Opera una cámara: encuadre, foco y zoom.",
      "si_falta": "La cámara queda fija o apagada; un plano menos para el director.",
      "rol_actual_juego": "cam"
    },
    {
      "key": "operador_ptz",
      "nombre": "Operador de cámara robótica (PTZ)",
      "que_hace": "Maneja varias cámaras robóticas desde un joystick.",
      "si_falta": "Las robóticas quedan en un solo plano fijo; no siguen a quien habla.",
      "rol_actual_juego": null
    },
    {
      "key": "cablero",
      "nombre": "Asistente de cámara / cablero",
      "que_hace": "Tiende y recoge cables, sigue al camarógrafo con el cable, cambia baterías y cuida el equipo.",
      "si_falta": "Cables enredados o pisados, gente que se tropieza, la cámara de mano no puede moverse; un conector se arranca y se pierde la señal.",
      "rol_actual_juego": null
    },
    {
      "key": "sonidista",
      "nombre": "Sonidista / operador de audio (A1)",
      "que_hace": "Mezcla micrófonos, música y ambiente para la transmisión.",
      "si_falta": "Audio saturado, micrófono abierto a destiempo, acoples; el streaming se escucha mal aunque la imagen sea buena.",
      "rol_actual_juego": "audio"
    },
    {
      "key": "microfonista",
      "nombre": "Microfonista / operador de boom (A2)",
      "que_hace": "Pone corbateros, lleva la caña con shotgun en entrevistas y revisa pilas.",
      "si_falta": "Entrevistas con audio lejano o con viento; corbateros mal puestos que rozan la ropa; pilas que se acaban en vivo.",
      "rol_actual_juego": null
    },
    {
      "key": "operador_repeticion",
      "nombre": "Operador de repeticiones (EVX/replay)",
      "que_hace": "Marca jugadas y lanza repeticiones en cámara lenta.",
      "si_falta": "No hay repeticiones en deportes: el gol se ve una sola vez y el cliente reclama.",
      "rol_actual_juego": null
    },
    {
      "key": "operador_graficos",
      "nombre": "Operador de gráficos (CG)",
      "que_hace": "Marcador, reloj, nombres, alineaciones, logos de auspiciantes.",
      "si_falta": "Sin marcador ni cintillos; nombres mal escritos; los auspiciantes no salen y se quejan.",
      "rol_actual_juego": null
    },
    {
      "key": "shader",
      "nombre": "Ingeniero de video / shader (CCU)",
      "que_hace": "Ajusta a distancia iris, color y negros de las cámaras de sistema para que todas se vean iguales.",
      "si_falta": "Cámaras con colores distintos (\"cancha radioactiva\"), imagen quemada al salir el sol o oscura al caer la noche.",
      "rol_actual_juego": null
    },
    {
      "key": "tecnico_transmision",
      "nombre": "Técnico de transmisión / streaming",
      "que_hace": "Encoder, internet, bonding, satélite o fibra; vigila que la señal llegue.",
      "si_falta": "Cortes de la transmisión sin que nadie lo note; nadie cambia al internet de respaldo.",
      "rol_actual_juego": "stream"
    },
    {
      "key": "piloto_dron",
      "nombre": "Piloto de dron",
      "que_hace": "Vuela el dron con permiso y seguridad.",
      "si_falta": "No se puede usar el dron (o se vuela sin permiso: multa y riesgo de accidente).",
      "rol_actual_juego": null
    },
    {
      "key": "coordinador_piso",
      "nombre": "Coordinador de piso / stage manager",
      "que_hace": "Es el contacto del director en el escenario o la cancha: da entradas a presentadores, controla tiempos.",
      "si_falta": "Presentadores que entran tarde, artistas que no saben cuándo empezar, entrevistas que no ocurren.",
      "rol_actual_juego": null
    },
    {
      "key": "runner",
      "nombre": "Asistente de producción / runner",
      "que_hace": "Lleva y trae cosas, compra pilas, guía a invitados, comida del equipo.",
      "si_falta": "Nadie va por la pieza que falta; el equipo trabaja con hambre y cansado.",
      "rol_actual_juego": null
    }
