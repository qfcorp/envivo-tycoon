# Copia este archivo como ".env" (en esta misma carpeta discord/) y llena los datos.
# El archivo .env NO se sube a GitHub (está en discord/.gitignore). Este ejemplo sí, por eso va vacío.

# Token del bot "EN VIVO Bot" (Developer Portal → tu aplicación → Bot → Reset Token → Copy)
DISCORD_TOKEN=

# ID del servidor de Discord (clic derecho en el ícono del servidor → Copiar ID del servidor)
DISCORD_GUILD_ID=

# Opcional: correo de soporte que aparecerá en los mensajes (déjalo vacío hasta que exista)
SOPORTE_CORREO=
